<script>
let currentLanguage = "en";

function toggleLanguage() {
    currentLanguage =
        currentLanguage === "en" ? "ur" : "en";

    document.querySelectorAll("[data-en][data-ur]")
        .forEach(function (element) {
            element.textContent =
                element.getAttribute("data-" + currentLanguage);

            if (currentLanguage === "ur") {
                element.setAttribute("dir", "rtl");
            } else {
                element.setAttribute("dir", "ltr");
            }
        });

    document.documentElement.lang = currentLanguage;
    document.documentElement.dir =
        currentLanguage === "ur" ? "rtl" : "ltr";

    document.getElementById("languageButton").textContent =
        currentLanguage === "en" ? "اردو" : "English";
}

document.getElementById("year").textContent =
    new Date().getFullYear();
</script>

