
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#123b75">

<title>Ali Education System | Tallu, Roundu</title>

<style>
:root {
    --blue: #123b75;
    --light-blue: #eaf3ff;
    --white: #ffffff;
    --text: #24334b;
    --gold: #ffc857;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, "Noto Sans Arabic", sans-serif;
    color: var(--text);
    background: #f7faff;
    line-height: 1.8;
}

a {
    text-decoration: none;
}

header {
    background: var(--white);
    box-shadow: 0 3px 15px #123b7515;
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 14px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
}

.logo {
    color: var(--blue);
    font-size: 21px;
    font-weight: 800;
    line-height: 1.3;
}

.logo small {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: #657b9b;
}

nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
}

nav a {
    color: var(--blue);
    font-size: 14px;
    font-weight: bold;
}

nav a:hover {
    color: #2476d4;
}

.lang-btn, .primary-btn {
    background: var(--blue);
    color: white;
    border: none;
    padding: 10px 17px;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
}

.hero {
    background: linear-gradient(120deg, #123b75, #287bd0);
    color: white;
    padding: 85px 6%;
    text-align: center;
    overflow: hidden;
}

.hero-content {
    max-width: 850px;
    margin: auto;
}

.school-badge {
    display: inline-block;
    background: #ffffff20;
    border: 1px solid #ffffff50;
    border-radius: 30px;
    padding: 5px 16px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.25;
    margin-bottom: 16px;
}

.hero p {
    max-width: 690px;
    margin: 0 auto 25px;
    color: #e7f1ff;
    font-size: 17px;
}

.hero .primary-btn {
    display: inline-block;
    background: var(--gold);
    color: #123b75;
    padding: 13px 25px;
}

.location {
    margin-top: 25px;
    font-size: 14px;
    color: #e7f1ff;
}

section {
    padding: 70px 6%;
    scroll-margin-top: 90px;
}

.container {
    max-width: 1100px;
    margin: auto;
}

.section-heading {
    text-align: center;
    margin-bottom: 35px;
}

.section-heading h2 {
    color: var(--blue);
    font-size: clamp(26px, 4vw, 36px);
    margin-bottom: 8px;
}

.section-heading p {
    color: #687994;
}

.intro-box {
    background: white;
    border-radius: 15px;
    padding: 35px;
    box-shadow: 0 8px 28px #123b750b;
    border-left: 5px solid var(--blue);
}

[dir="rtl"] .intro-box {
    border-left: none;
    border-right: 5px solid var(--blue);
}

.intro-box p {
    margin-bottom: 15px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}

.card {
    background: white;
    padding: 28px 22px;
    border-radius: 13px;
    text-align: center;
    border: 1px solid #e3ecf8;
    transition: transform .2s, box-shadow .2s;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px #123b7515;
}

.icon {
    width: 65px;
    height: 65px;
    display: grid;
    place-items: center;
    margin: 0 auto 14px;
    background: var(--light-blue);
    border-radius: 50%;
    font-size: 30px;
}

.card h3 {
    color: var(--blue);
    margin-bottom: 10px;
    font-size: 19px;
}

.features-section {
    background: var(--light-blue);
}

.mission {
    background: var(--blue);
    color: white;
    text-align: center;
}

.mission h2 {
    color: var(--gold);
    font-size: 30px;
    margin-bottom: 15px;
}

.mission p {
    max-width: 760px;
    margin: auto;
}

.admission-box {
    max-width: 760px;
    margin: auto;
    background: white;
    border: 1px solid #e0eaf8;
    border-radius: 15px;
    padding: 32px;
    text-align: center;
}

.admission-box p {
    margin: 10px 0;
}

.contact-details {
    margin-top: 22px;
    padding: 18px;
    background: var(--light-blue);
    border-radius: 10px;
}

footer {
    background: #0b2448;
    color: white;
    padding: 27px 6%;
    text-align: center;
}

footer p {
    font-size: 14px;
}

footer .tagline {
    color: #bcd6fa;
    margin-top: 5px;
}

[dir="rtl"] {
    text-align: right;
    font-family: Arial, "Noto Naskh Arabic", sans-serif;
}

@media (max-width: 850px) {
    .navbar {
        flex-wrap: wrap;
        justify-content: center;
        text-align: center;
    }

    nav {
        justify-content: center;
        gap: 12px;
    }

    .cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 540px) {
    .cards {
        grid-template-columns: 1fr;
    }

    section {
        padding: 48px 5%;
    }

    .hero {
        padding: 65px 5%;
    }

    .intro-box, .admission-box {
        padding: 22px;
    }

    nav a {
        font-size: 13px;
    }
}
</style>
</head>

